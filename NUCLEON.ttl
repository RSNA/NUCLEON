:DoubleBetaMinusDecay rdf:type owl:NamedIndividual ,
                               :DecayMode ;
                      :changeInAtomicNumber 2 ;
                      :changeInMassNumber 0 ;
                      rdfs:comment "Two neutrons simultaneously convert to protons, emitting two electrons and two antineutrinos."@en ;
                      rdfs:label "double beta-minus decay"@en ;
                      skos:altLabel "2B-"@en ,
                                    "2beta-"@en ,
                                    "2β−"@en ,
                                    "β−β−"@en .


###  https://rsna.org/radlex/nucleon#DoubleBetaPlusDecay
:DoubleBetaPlusDecay rdf:type owl:NamedIndividual ,
                              :DecayMode ;
                     :changeInAtomicNumber -2 ;
                     :changeInMassNumber 0 ;
                     rdfs:comment "Two protons simultaneously convert to neutrons, emitting two positrons and two neutrinos."@en ;
                     rdfs:label "double beta-plus decay"@en ;
                     skos:altLabel "2B+"@en ,
                                   "2beta+"@en ,
                                   "2β+"@en ,
                                   "β+β+"@en .


###  https://rsna.org/radlex/nucleon#DoubleElectronCapture
:DoubleElectronCapture rdf:type owl:NamedIndividual ,
                                :DecayMode ;
                       :changeInAtomicNumber -2 ;
                       :changeInMassNumber 0 ;
                       rdfs:comment "Two nuclear protons simultaneously capture two inner-shell electrons, becoming neutrons and emitting two neutrinos. Net nuclear change is identical to double beta-plus decay."@en ;
                       rdfs:label "double electron capture"@en ;
                       skos:altLabel "2EC"@en ,
                                     "2ε"@en ,
                                     "εε"@en .



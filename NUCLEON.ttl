@prefix : <https://rsna.org/radlex/nucleon#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <https://rsna.org/radlex/nucleon#> .

<https://rsna.org/radlex/nucleon/> rdf:type owl:Ontology ;
                                    owl:versionIRI <https://rsna.org/radlex/nucleon/1.4/> ;
                                    owl:versionInfo "1.4" ;
                                    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
                                    rdfs:comment "An OWL 2 DL ontology of the 118 chemical elements, their nuclides (ground states and metastable isomers) and radioactive decay. Each element and nuclide IRI is punned: an owl:Class (element classes under :Element, nuclide classes under :Nuclide) and an owl:NamedIndividual that carries the quantitative assertions. The class reading also carries generated annotation properties (sub-properties of :displayValue) that mirror the individual's values for class-oriented viewers. Identifiers are transparent: an element by its symbol (:Tc), a nuclide by symbol and mass number (:Tc-99), an isomer with suffix m, m2, ... m6 after NUBASE2020's state index (:Tc-99m, :Lu-177m3), and a decay branch by its parent with _b1, _b2, ... (:Tc-99m_b1). Sources. Ground-state half-lives, decay widths, spin-parities, natural abundances, decay modes, branching ratios and Q-values: IAEA LiveChart of Nuclides data export (ENSDF evaluations; abundances from NUBASE2020; extracted 18 October 2023). Metastable isomers, including excitation energies, half-lives, spin-parities, decay modes and branching ratios, and ground-state values the export lacks: NUBASE2020 (Kondev et al., Chinese Physics C 45:030001, 2021). Element names and symbols: IUPAC; names in German, Spanish, French, Italian, Russian and Chinese as language-tagged skos:altLabel. Each decay branch's daughter is derived, not transcribed: the parent's Z and A plus the decay mode's :changeInAtomicNumber and :changeInMassNumber, resolved to the daughter's ground state; fission branches have no daughter. Mappings (skos:exactMatch): Ontology of Chemical Elements (OCE), SNOMED CT, and the concepts DICOM PS3.16 release 2026c cites for nuclides in CID 18 (Radiopharmaceutical Isotope, version 20251111) and CID 4020 (PET Radionuclide, version 20160119); :dicomCode holds each such nuclide's DICOM code. Build and validation scripts, change history and validation results: https://github.com/RSNA/NUCLEON."@en ;
                                    rdfs:label "NUCLEON: Nuclide and Element Ontology"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/license
dcterms:license rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


###  https://rsna.org/radlex/nucleon#dicomCode
:dicomCode rdf:type owl:AnnotationProperty ;
           rdfs:comment "The DICOM code that denotes this nuclide, as the coding scheme designator (0008,0102) and code value (0008,0100) pair that appears in a Radionuclide Code Sequence (0054,0300), written designator:value. Transcribed from the context groups named by :dicomContextGroup."@en ;
           rdfs:label "DICOM code"@en .


###  https://rsna.org/radlex/nucleon#dicomContextGroup
:dicomContextGroup rdf:type owl:AnnotationProperty ;
                   rdfs:comment "A DICOM PS3.16 context group in which this nuclide appears: CID 18 (Radiopharmaceutical Isotope) and/or CID 4020 (PET Radionuclide)."@en ;
                   rdfs:label "DICOM context group"@en .


###  https://rsna.org/radlex/nucleon#halfLifeUnit
:halfLifeUnit rdf:type owl:AnnotationProperty ;
              rdfs:comment "The unit of :halfLifeValue: one of as, ps, ns, µs, ms, s, m (minutes), h, d, or a (Julian years, 365.25 d)."@en ;
              rdfs:label "half-life unit"@en .


###  https://rsna.org/radlex/nucleon#halfLifeValue
:halfLifeValue rdf:type owl:AnnotationProperty ;
               rdfs:comment "The numeric half-life of a radioactive nuclide, in the unit given by :halfLifeUnit, as reported by the source data. Absent for stable nuclides and for the handful of unbound resonances reported as a decay width instead (see :decayWidthValue)."@en ;
               rdfs:label "half-life value"@en .


###  https://rsna.org/radlex/nucleon#spinParity
:spinParity rdf:type owl:AnnotationProperty ;
            rdfs:comment "Nuclear spin and parity of the nuclide in spectroscopic notation (e.g. '1/2+', '(3+,4+)'), as reported by the source data. Kept as free text since it is a compound spectroscopic notation rather than a single comparable quantity."@en ;
            rdfs:label "spin-parity"@en .


###  https://rsna.org/radlex/nucleon#displayValue
:displayValue rdf:type owl:AnnotationProperty ;
              rdfs:comment "Parent of the annotation properties that mirror, on the class reading of a punned element or nuclide IRI, values asserted on its individual reading, so that class-oriented viewers such as BioPortal can display them. Generated from the datatype properties by scripts/add_display_annotations.py; the datatype properties are authoritative. Each sub-property names the property it mirrors with :mirrorOf."@en ;
              rdfs:label "display value"@en .


###  https://rsna.org/radlex/nucleon#mirrorOf
:mirrorOf rdf:type owl:AnnotationProperty ;
          rdfs:comment "Relates a :displayValue annotation property to the datatype property whose values it mirrors."@en ;
          rdfs:label "mirror of"@en .


###  https://rsna.org/radlex/nucleon#decaySummary
:decaySummary rdf:type owl:AnnotationProperty ;
              rdfs:subPropertyOf :displayValue ;
              rdfs:comment "One-line summary of a nuclide's decay branches, generated from :hasDecayBranch: mode symbol, branching ratio in percent (? where the source gives none; ~, < or > where the source gives an approximation or limit) and daughter. \"stable\" for a stable nuclide with no branch."@en ;
              rdfs:label "decay summary"@en .


###  https://rsna.org/radlex/nucleon#atomicNumberDisplay
:atomicNumberDisplay rdf:type owl:AnnotationProperty ;
                     rdfs:subPropertyOf :displayValue ;
                     :mirrorOf :atomicNumber ;
                     rdfs:comment "Mirror of :atomicNumber on the class reading, for display. Generated; do not edit."@en ;
                     rdfs:label "atomic number (display)"@en .


###  https://rsna.org/radlex/nucleon#massNumberDisplay
:massNumberDisplay rdf:type owl:AnnotationProperty ;
                   rdfs:subPropertyOf :displayValue ;
                   :mirrorOf :massNumber ;
                   rdfs:comment "Mirror of :massNumber on the class reading, for display. Generated; do not edit."@en ;
                   rdfs:label "mass number (display)"@en .


###  https://rsna.org/radlex/nucleon#neutronNumberDisplay
:neutronNumberDisplay rdf:type owl:AnnotationProperty ;
                      rdfs:subPropertyOf :displayValue ;
                      :mirrorOf :neutronNumber ;
                      rdfs:comment "Mirror of :neutronNumber on the class reading, for display. Generated; do not edit."@en ;
                      rdfs:label "neutron number (display)"@en .


###  https://rsna.org/radlex/nucleon#halfLifeDisplay
:halfLifeDisplay rdf:type owl:AnnotationProperty ;
                 rdfs:subPropertyOf :displayValue ;
                 :mirrorOf :halfLife ;
                 rdfs:comment "Mirror of :halfLife on the class reading, for display. Generated; do not edit."@en ;
                 rdfs:label "half-life in seconds (display)"@en .


###  https://rsna.org/radlex/nucleon#isStableDisplay
:isStableDisplay rdf:type owl:AnnotationProperty ;
                 rdfs:subPropertyOf :displayValue ;
                 :mirrorOf :isStable ;
                 rdfs:comment "Mirror of :isStable on the class reading, for display. Generated; do not edit."@en ;
                 rdfs:label "is stable (display)"@en .


###  https://rsna.org/radlex/nucleon#metastableStateDisplay
:metastableStateDisplay rdf:type owl:AnnotationProperty ;
                        rdfs:subPropertyOf :displayValue ;
                        :mirrorOf :metastableState ;
                        rdfs:comment "Mirror of :metastableState on the class reading, for display. Generated; do not edit."@en ;
                        rdfs:label "metastable state (display)"@en .


###  https://rsna.org/radlex/nucleon#excitationEnergyDisplay
:excitationEnergyDisplay rdf:type owl:AnnotationProperty ;
                         rdfs:subPropertyOf :displayValue ;
                         :mirrorOf :excitationEnergy ;
                         rdfs:comment "Mirror of :excitationEnergy on the class reading, for display. Generated; do not edit."@en ;
                         rdfs:label "excitation energy in keV (display)"@en .


###  https://rsna.org/radlex/nucleon#naturalAbundanceDisplay
:naturalAbundanceDisplay rdf:type owl:AnnotationProperty ;
                         rdfs:subPropertyOf :displayValue ;
                         :mirrorOf :naturalAbundance ;
                         rdfs:comment "Mirror of :naturalAbundance on the class reading, for display. Generated; do not edit."@en ;
                         rdfs:label "natural abundance in percent (display)"@en .


###  https://rsna.org/radlex/nucleon#decayWidthValueDisplay
:decayWidthValueDisplay rdf:type owl:AnnotationProperty ;
                        rdfs:subPropertyOf :displayValue ;
                        :mirrorOf :decayWidthValue ;
                        rdfs:comment "Mirror of :decayWidthValue on the class reading, for display. Generated; do not edit."@en ;
                        rdfs:label "decay width value (display)"@en .


###  https://rsna.org/radlex/nucleon#decayWidthUnitDisplay
:decayWidthUnitDisplay rdf:type owl:AnnotationProperty ;
                       rdfs:subPropertyOf :displayValue ;
                       :mirrorOf :decayWidthUnit ;
                       rdfs:comment "Mirror of :decayWidthUnit on the class reading, for display. Generated; do not edit."@en ;
                       rdfs:label "decay width unit (display)"@en .


###  https://rsna.org/radlex/nucleon#groupNumberDisplay
:groupNumberDisplay rdf:type owl:AnnotationProperty ;
                    rdfs:subPropertyOf :displayValue ;
                    :mirrorOf :groupNumber ;
                    rdfs:comment "Mirror of :groupNumber on the class reading, for display. Generated; do not edit."@en ;
                    rdfs:label "group number (display)"@en .


###  https://rsna.org/radlex/nucleon#periodNumberDisplay
:periodNumberDisplay rdf:type owl:AnnotationProperty ;
                     rdfs:subPropertyOf :displayValue ;
                     :mirrorOf :periodNumber ;
                     rdfs:comment "Mirror of :periodNumber on the class reading, for display. Generated; do not edit."@en ;
                     rdfs:label "period number (display)"@en .


#################################################################
#    Object Properties
#################################################################

###  https://rsna.org/radlex/nucleon#decayMode
:decayMode rdf:type owl:ObjectProperty ;
           rdfs:domain :DecayBranch ;
           rdfs:range :DecayMode ;
           rdfs:comment "The type of decay (a :DecayMode) that this branch proceeds by."@en ;
           rdfs:label "decay mode"@en .


###  https://rsna.org/radlex/nucleon#decayProduct
:decayProduct rdf:type owl:ObjectProperty ;
              rdfs:domain :DecayBranch ;
              rdfs:range :Nuclide ;
              rdfs:comment "The daughter nuclide produced by this decay branch. (For spontaneous fission this is typically left unspecified, as the products vary.)"@en ;
              rdfs:label "decay product"@en ;
              skos:altLabel "daughter"@en .


###  https://rsna.org/radlex/nucleon#hasDecayBranch
:hasDecayBranch rdf:type owl:ObjectProperty ;
                rdfs:domain :Nuclide ;
                rdfs:range :DecayBranch ;
                rdfs:comment "Relates a radioactive nuclide to one of its decay routes."@en ;
                rdfs:label "has decay branch"@en .


###  https://rsna.org/radlex/nucleon#hasNuclide
:hasNuclide rdf:type owl:ObjectProperty ;
            owl:inverseOf :isNuclideOf ;
            rdf:type owl:InverseFunctionalProperty ;
            rdfs:domain :Element ;
            rdfs:range :Nuclide ;
            rdfs:comment "Relates a chemical element (an :Element instance, e.g. :H) directly to each of its nuclides (a :Nuclide instance, e.g. :H-3)."@en ;
            rdfs:label "has nuclide"@en .


###  https://rsna.org/radlex/nucleon#isNuclideOf
:isNuclideOf rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Nuclide ;
             rdfs:range :Element ;
             rdfs:comment "Inverse of :hasNuclide: relates a nuclide (a :Nuclide instance, e.g. :H-3) to the chemical element it is a nuclide of (an :Element instance, e.g. :H)."@en ;
             rdfs:label "is nuclide of"@en .


#################################################################
#    Data properties
#################################################################

###  https://rsna.org/radlex/nucleon#atomicNumber
:atomicNumber rdf:type owl:DatatypeProperty ;
              rdfs:domain [ rdf:type owl:Class ;
                            owl:unionOf ( :Element
                                          :Nuclide
                                        )
                          ] ;
              rdfs:range xsd:positiveInteger ;
              rdfs:comment "The number of protons in the nucleus of an atom (Z). Asserted both on each :Element instance (e.g. :H) and, redundantly but for convenience, on each :Nuclide instance, where it always agrees with the value on the element reached via :isNuclideOf. For a nuclide, :atomicNumber + :neutronNumber = :massNumber."@en ;
              rdfs:label "atomic number"@en ;
              skos:altLabel "Z" .


###  https://rsna.org/radlex/nucleon#branchingRatio
:branchingRatio rdf:type owl:DatatypeProperty ;
                rdfs:domain :DecayBranch ;
                rdfs:range xsd:decimal ;
                rdfs:comment "The percentage of decays of the parent nuclide that proceed via this branch (0-100). The branching ratios of a nuclide's branches sum to approximately 100."@en ;
                rdfs:label "branching ratio"@en .


###  https://rsna.org/radlex/nucleon#changeInAtomicNumber
:changeInAtomicNumber rdf:type owl:DatatypeProperty ;
                      rdfs:domain :DecayMode ;
                      rdfs:range xsd:integer ;
                      rdfs:comment "The change in atomic number (dZ = Z_daughter - Z_parent) characteristic of a decay mode."@en ;
                      rdfs:label "change in atomic number"@en ;
                      skos:altLabel "delta-Z" ,
                                    "ΔZ" .


###  https://rsna.org/radlex/nucleon#changeInMassNumber
:changeInMassNumber rdf:type owl:DatatypeProperty ;
                    rdfs:domain :DecayMode ;
                    rdfs:range xsd:integer ;
                    rdfs:comment "The change in mass number (dA = A_daughter - A_parent) characteristic of a decay mode."@en ;
                    rdfs:label "change in mass number"@en ;
                    skos:altLabel "delta-A" ,
                                  "ΔA" .


###  https://rsna.org/radlex/nucleon#decayEnergy
:decayEnergy rdf:type owl:DatatypeProperty ;
             rdfs:domain :DecayBranch ;
             rdfs:range xsd:decimal ;
             rdfs:comment "The energy released by this decay branch (the Q-value), in MeV."@en ;
             rdfs:label "decay energy (Q-value)"@en .


###  https://rsna.org/radlex/nucleon#decayWidthUnit
:decayWidthUnit rdf:type owl:DatatypeProperty ;
                rdfs:domain :Nuclide ;
                rdfs:range xsd:string ;
                rdfs:comment "The unit of :decayWidthValue: one of eV, keV, or MeV."@en ;
                rdfs:label "decay width unit"@en .


###  https://rsna.org/radlex/nucleon#decayWidthValue
:decayWidthValue rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Nuclide ;
                 rdfs:range xsd:decimal ;
                 rdfs:comment "For a handful of extremely short-lived unbound nuclear resonances, the source data reports a decay width (Gamma) instead of a half-life. This is that numeric value, in the unit given by :decayWidthUnit."@en ;
                 rdfs:label "decay width value"@en .


###  https://rsna.org/radlex/nucleon#excitationEnergy
:excitationEnergy rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Nuclide ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "Excitation energy of a metastable isomer above the ground state, in keV, from NUBASE2020. Distinguishes isomers of the same nuclide; :metastableState gives the NUBASE state index (1 = m, 2 = n, ...)."@en ;
                  rdfs:label "excitation energy (keV)"@en .


###  https://rsna.org/radlex/nucleon#groupNumber
:groupNumber rdf:type owl:DatatypeProperty ;
             rdfs:domain :Element ;
             rdfs:range xsd:integer ;
             rdfs:comment "The column (1-18) of the standard periodic table in which the element is placed. A nuclide's group is that of its element, reached via :isNuclideOf."@en ;
             rdfs:label "group number"@en .


###  https://rsna.org/radlex/nucleon#halfLife
:halfLife rdf:type owl:DatatypeProperty ;
          rdfs:domain :Nuclide ;
          rdfs:range xsd:double ;
          rdfs:comment "The nuclide's half-life normalized to seconds, enabling direct numeric comparison across all nuclides regardless of the original unit. Values are typed xsd:double throughout: the range spans some 50 orders of magnitude, and xsd:decimal admits no exponent notation. For entries reported as a decay width Gamma rather than a time, this is computed via the time-energy uncertainty relation t(1/2) = hbar * ln(2) / Gamma, using hbar = 6.582119569e-16 eV*s. Absent for stable nuclides and for the small number of nuclides with no half-life data in the source."@en ;
          rdfs:label "half-life"@en .


###  https://rsna.org/radlex/nucleon#isStable
:isStable rdf:type owl:DatatypeProperty ;
          rdfs:domain :Nuclide ;
          rdfs:range xsd:boolean ;
          rdfs:comment "True if the nuclide is stable (no known radioactive decay); false if it is radioactive."@en ;
          rdfs:label "is stable"@en .


###  https://rsna.org/radlex/nucleon#massNumber
:massNumber rdf:type owl:DatatypeProperty ;
            rdfs:domain :Nuclide ;
            rdfs:range xsd:positiveInteger ;
            rdfs:comment "The total number of nucleons (protons + neutrons, A) in the nuclide."@en ;
            rdfs:label "mass number"@en .


###  https://rsna.org/radlex/nucleon#metastableState
:metastableState rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Nuclide ;
                 rdfs:range xsd:integer ;
                 rdfs:comment "For a nuclear isomer, the index of the excited (metastable) state above the ground state (1 = first isomeric state 'm', 2 = second 'm2', etc.). Absent for ground-state nuclides."@en ;
                 rdfs:label "metastable state"@en .


###  https://rsna.org/radlex/nucleon#naturalAbundance
:naturalAbundance rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Nuclide ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "For a naturally occurring nuclide, its mole fraction among the natural isotopes of its element, as a percentage (0-100). Present for naturally occurring nuclides. From the IAEA LiveChart export (whose abundances are those of NUBASE2020) for ground states, and from NUBASE2020 for Ta-180m."@en ;
                  rdfs:label "natural abundance"@en .


###  https://rsna.org/radlex/nucleon#neutronNumber
:neutronNumber rdf:type owl:DatatypeProperty ;
               rdfs:domain :Nuclide ;
               rdfs:range xsd:nonNegativeInteger ;
               rdfs:comment "The number of neutrons in the nucleus of a nuclide (N), equal to :massNumber minus :atomicNumber. Zero for hydrogen-1."@en ;
               rdfs:label "neutron number"@en ;
               skos:altLabel "N" .


###  https://rsna.org/radlex/nucleon#partialHalfLifeSeconds
:partialHalfLifeSeconds rdf:type owl:DatatypeProperty ;
                        rdfs:domain :DecayBranch ;
                        rdfs:range xsd:double ;
                        rdfs:comment "Optional: the partial half-life associated with this branch alone, in seconds, equal to the nuclide's total half-life divided by this branch's fractional branching ratio."@en ;
                        rdfs:label "partial half-life (seconds)"@en .


###  https://rsna.org/radlex/nucleon#periodNumber
:periodNumber rdf:type owl:DatatypeProperty ;
              rdfs:domain :Element ;
              rdfs:range xsd:integer ;
              rdfs:comment "The row (1-7) of the standard periodic table in which the element is placed. A nuclide's period is that of its element, reached via :isNuclideOf."@en ;
              rdfs:label "period number"@en .


#################################################################
#    Classes
#################################################################

###  https://rsna.org/radlex/nucleon#DecayBranch
:DecayBranch rdf:type owl:Class ;
             rdfs:comment "One decay route of a radioactive nuclide, bundling the mode of decay, the resulting daughter nuclide, the branching ratio, and (optionally) the decay energy. A nuclide with several competing routes has several :DecayBranch individuals, one per route."@en ;
             rdfs:label "decay branch"@en .


###  https://rsna.org/radlex/nucleon#DecayMode
:DecayMode rdf:type owl:Class ;
           rdfs:comment "A type of radioactive decay (e.g. alpha emission, beta-minus decay, electron capture). The instances below form a controlled vocabulary; each carries the characteristic change in atomic number (:changeInAtomicNumber, dZ) and mass number (:changeInMassNumber, dA) it produces, which relates a parent nuclide to its daughter and allows a daughter assignment to be checked (Z_daughter = Z_parent + dZ, A_daughter = A_parent + dA)."@en ;
           rdfs:label "decay mode"@en .


###  https://rsna.org/radlex/nucleon#Element
:Element rdf:type owl:Class ;
         rdfs:comment "A chemical element, i.e. a species of atom having the same number of protons in its atomic nucleus, considered purely as a chemical species (independent of any particular nuclide's mass number or nuclear energy state). Each specific element (e.g. :H) is modeled as an individual instance of :Element, carrying its atomic number, group, and period as data properties. Individual nuclides are modeled separately as instances of :Nuclide and linked to their element via :hasNuclide. See :Nuclide."@en ;
         rdfs:label "element"@en ;
         skos:exactMatch <http://snomed.info/id/57795002> .


###  https://rsna.org/radlex/nucleon#Nuclide
:Nuclide rdf:type owl:Class ;
         rdfs:comment "A distinct species of atomic nucleus, characterized by its number of protons (Z) and neutrons (i.e. mass number A), and, where applicable, its nuclear excitation (ground state or a specific metastable/isomeric state). Each nuclide is an individual instance of :nuclide (e.g. :H-3 a :nuclide) and is linked to the single chemical element it belongs to via :isNuclideOf / :hasNuclide (e.g. :H-3 :isNuclideOf :H). :Element models the element as a pure chemical species (defined by Z alone); :Nuclide models the distinct nuclear species (defined by Z, A, and energy state) that make up that element. A nuclide's atomic number, neutron number, mass number and metastable state are given directly by :atomicNumber, :neutronNumber, :massNumber and :metastableState; its group and period are those of its element, reached via :isNuclideOf. The free neutron is not modeled here, since it is not the nuclide of any chemical element."@en ;
         rdfs:label "nuclide"@en .


#################################################################
#    Individuals
#################################################################

###  https://rsna.org/radlex/nucleon#Ac
:Ac rdf:type owl:Class ,
             owl:NamedIndividual ,
             :Element ;
    rdfs:subClassOf :Element ;
    :hasNuclide :Ac-205 ,
                :Ac-206 ,
                :Ac-206m ,
                :Ac-207 ,
                :Ac-208 ,
                :Ac-208m ,
                :Ac-209 ,
                :Ac-210 ,
                :Ac-211 ,
                :Ac-212 ,
                :Ac-213 ,
                :Ac-214 ,
                :Ac-215 ,
                :Ac-215m ,
                :Ac-215m2 ,
                :Ac-216 ,
                :Ac-216m ,
                :Ac-216m2 ,
                :Ac-217 ,
                :Ac-217m ,
                :Ac-218 ,
                :Ac-218m ,
                :Ac-218m2 ,
                :Ac-219 ,
                :Ac-220 ,
                :Ac-221 ,
                :Ac-222 ,
                :Ac-222m ,
                :Ac-223 ,
                :Ac-224 ,
                :Ac-225 ,
                :Ac-226 ,
                :Ac-227 ,
                :Ac-228 ,
                :Ac-228m ,
                :Ac-229 ,
                :Ac-230 ,
                :Ac-231 ,
                :Ac-232 ,
                :Ac-233 ,
                :Ac-234 ,
                :Ac-234m ,
                :Ac-234m2 ,
                :Ac-235 ,
                :Ac-236 ;
    :atomicNumber 89 ;
    :groupNumber 3 ;
    :periodNumber 7 ;
    rdfs:label "Ac" ;
    rdfs:seeAlso <https://pubchem.ncbi.nlm.nih.gov/element/89> ;
    skos:altLabel "Actinium"@de ,
                  "actinio"@es ,
                  "actinium"@en ,
                  "actinium"@fr ,
                  "attinio"@it ,
                  "актиний"@ru ,
                  "錒"@zh-hant ,
                  "锕"@zh-hans ;
    skos:exactMatch <http://purl.obolibrary.org/obo/CHEBI_33337> ,
                    <http://snomed.info/id/1396009> ;
    :atomicNumberDisplay 89 ;
    :groupNumberDisplay 3 ;
    :periodNumberDisplay 7 .


###  https://rsna.org/radlex/nucleon#Ac-205
:Ac-205 rdf:type owl:Class ,
                 owl:NamedIndividual ,
                 :Nuclide ;
        rdfs:subClassOf :Nuclide ;
        :hasDecayBranch :Ac-205_b1 ;
        :atomicNumber 89 ;
        :halfLife "0.02"^^xsd:double ;
        :isStable false ;
        :massNumber 205 ;
        :neutronNumber 116 ;
        rdfs:label "Ac-205" ;
        skos:altLabel "actinium-205"@en ,
                      "(205)Ac" ,
                      "(205)actinium"@en ;
        :halfLifeUnit "ms" ;
        :halfLifeValue 20 ;
        :spinParity "(9/2-)" ;
        :atomicNumberDisplay 89 ;
        :massNumberDisplay 205 ;
        :neutronNumberDisplay 116 ;
        :halfLifeDisplay "0.02"^^xsd:double ;
        :isStableDisplay false ;
        :decaySummary "α 100% → Fr-201"@en .


###  https://rsna.org/radlex/nucleon#Ac-205_b1
:Ac-205_b1 rdf:type owl:NamedIndividual ,
                    :DecayBranch ;
           :decayMode :AlphaDecay ;
           :decayProduct :Fr-201 ;
           :branchingRatio 100 ;
